/** 
Crie um programa que:

leia a idade
informe se a pessoa é maior ou menor de idade

*/
programa{
    funcao inicio()
    {
        inteiro idade
        escreva("Escreva qual sua idade: ")
        leia (idade)
        se (idade >= 18){
            escreva("Você é maior de idade.")
        }
        senao
        {
            escreva("Você é menor de idade.")
            
        }
        }
    }
}