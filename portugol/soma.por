/** 
Crie um programa que:

leia dois números
mostre a soma
*/
programa {
    funcao inicio(){
        inteiro n1, n2, soma
        escreva ("Digite o primeiro valor para soma: ")
        leia (n1)
        esceva ("Digite o segundo valor para soma: ")
        leia (n2)
        soma (n1 + n2)
        escreva ("A soma dos números é: ", soma)
        

    }
}
    